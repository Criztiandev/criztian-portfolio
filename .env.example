# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# Local Supabase values come from `pnpm exec supabase status` after `supabase start`.

# Public — inlined into the browser bundle. Never put a secret here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only — never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
OWNER_EMAIL=you@example.com

# preview = write an inspectable file to .local/email-previews/, send nothing.
EMAIL_MODE=preview
